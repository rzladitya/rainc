{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rainc",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "routes": [
    {
      "pattern": "rainc.web.id",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
