{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rainc",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "rainc.tech",
      "custom_domain": true
    },
    {
      "pattern": "rainc.web.id",
      "custom_domain": true
    },
    {
      "pattern": "www.rainc.tech",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "main": "worker.mjs"
}
